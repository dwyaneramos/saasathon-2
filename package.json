{
  "name": "hackathon-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "install:all": "npm install --prefix client && npm install --prefix server",
    "build": "npm run install:all && npm run build --prefix client && npm run build --prefix server",
    "start": "npm run start --prefix server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "supabase": "^2.118.0"
  },
  "dependencies": {
    "all": "^0.0.0"
  }
}
