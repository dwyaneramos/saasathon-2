PORT=5050

# Required by the document pipeline (src/pipeline) - never commit a real key.
OPENAI_API_KEY=

# Optional overrides - defaults are gpt-6-luna (classify) and gpt-6-astra (extract).
# OPENAI_CLASSIFY_MODEL=
# OPENAI_EXTRACT_MODEL=
# OPENAI_PLAN_MODEL=

# Service-role Supabase access for the per-project documents/wiring-plan routes.
# Get these from `supabase status` when running the local stack. Never expose the
# service role key to the browser.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
