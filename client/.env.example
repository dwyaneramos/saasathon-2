VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Shared demo account (supabase/seed.sql). Powers the "Try without login" button on /login.
VITE_DEMO_EMAIL=demo@pika.local
VITE_DEMO_PASSWORD=demo-password-123

# Optional, local dev only: shows a one-click "Dev quick login" button on /login.
# Use a throwaway test account, never a real one. Ignored in production builds.
VITE_DEV_LOGIN_EMAIL=
VITE_DEV_LOGIN_PASSWORD=